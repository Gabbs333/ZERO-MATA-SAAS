# Supabase Configuration for Testing
# Copy this file to .env and fill in your test database credentials

# PostgreSQL connection for direct database testing
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Connexion directe à la base Supabase, utilisée par apply_migration.js
# (le host db.<project-ref>.supabase.co est IPv6 uniquement ; le pooler est IPv4)
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Variante par champs :
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<mot-de-passe>
# SUPABASE_DB_NAME=postgres

# Supabase credentials (optional, for integration tests)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
